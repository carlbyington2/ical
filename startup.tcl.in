###############################################################################
# Ical initialization.
#
# This code is linked into the ical binaries and executed at startup.

proc ical_init {} {
    set tv [info tclversion]
    if {[package vcompare $tv 9.0] < 0} {
        puts stderr "Ical requires at least Tcl version 9.0"
        exit 1
    }

    # Make sure there is "HOME" environment variable so that
    # tilde expansion does not blow up.
    global env
    if ![info exists env(HOME)] {set env(HOME) "/"}

    # Initialize options
    global ical
    set ical(author)            {sanjay@pa.dec.com}
    set ical(version)           {@PACKAGE_VERSION@}
    set ical(mailer)            {@MAILER@}
    set ical(docdir)            {@pkgdocdir@}
    set ical(libparent)         {@pkglibdir@}
    set ical(library)           {@icallibdir@}
    set ical(startdate)         [date today]
    set ical(iconic)            0
    set ical(prefs)             {}
    set ical(geometry)          {}
    set ical(iconposition)      {}
    set ical(dpi_scaling)       1.5
    set ical(timezone)          [ical_default_timezone]

    # Handle environment variables
    if [info exists env(ICAL_LIBRARY)] {set ical(library) $env(ICAL_LIBRARY)}
    if [info exists env(CALENDAR)] {
        set ical(calendar) $env(CALENDAR)
    } else {
        set ical(calendar) [ical_expand_file_name [file tildeexpand ~/.calendar]]
    }

    # Auto-loading path
    global auto_path
    set auto_path [concat\
                   [list $ical(library) $ical(library)/tcllib]\
                   $auto_path]

    global have_tk
    set have_tk [string compare [info commands tk] ""]

    support_init
    if $have_tk ical_tk_init
}

proc scrollbar_width {} {
    global ical
    return  [expr 15 * $ical(dpi_scaling)]
}

proc ical_default_timezone {} {
    set file_path "/etc/localtime"

    # Ensure the file exists and is indeed a symbolic link
    if {[file exists $file_path] && [file type $file_path] eq "link"} {

        # Read the underlying target path (e.g., ../usr/share/zoneinfo/America/New_York)
        set target_path [file readlink $file_path]

        # Normalize path segments to confidently locate the zoneinfo boundary
        set split_path [file split $target_path]
        set index [lsearch -exact $split_path "zoneinfo"]

        if {$index != -1} {
            # Extract everything following the "zoneinfo" index segment
            set tz_parts [lrange $split_path [expr {$index + 1}] end]
            set timezone [file join {*}$tz_parts]
        } else {
            # Fallback if the link structure is non-standard but contains trailing parts
            set timezone "<Local>"
        }
    } else {
        # Failover strategy if symlink is missing/broken
        set timezone "<Local>"
    }
    return $timezone
}

proc ical_tk_init {} {
    global tk_version
    if {[package vcompare $tk_version 9.0] < 0} {
        puts stderr "Ical requires at least Tk version 9.0"
        exit 1
    }

    # Handle geometry value already parsed by Tk
    global geometry ical
    if [info exists geometry] {set ical(geometry) $geometry}

    # Load Tk support code
    tk_support_init
}
