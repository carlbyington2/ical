#!/bin/bash

if [ ! -f developer.tools/ical.manpage.tex ]; then
    echo "run this from the main ical directory"
else
    tf=/tmp/tcl.files
    rm -f $tf

    # patch the tcl files
    grep -E -rl '^(class|action) ' . | while read fn; do
        if [[ $fn == *.tcl ]]; then
            echo $fn >>$tf
            mv $fn $fn.save
            cp -a $fn.save $fn
            sed -i -r -e 's/^(class|action) /proc /g' $fn
        fi
    done

    # rebuild the indices
    echo 'auto_mkindex .      *.tcl' | tclsh
    echo 'auto_mkindex tcllib *.tcl' | tclsh
    echo 'auto_mkindex tests  *.tcl' | tclsh

    # undo the patches
    cat $tf | while read fn; do
        mv $fn.save $fn
    done
fi
